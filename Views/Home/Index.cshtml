@model IEnumerable<practica2.Models.Inmueble>

<h2>Inmuebles Disponibles</h2>

<table class="table">
    <thead>
        <tr>
            <th>Título</th>
            <th>Ciudad</th>
            <th>Tipo</th>
            <th>Precio</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Titulo</td>
                <td>@item.Ciudad</td>
                <td>@item.Tipo</td>
                <td>@item.Precio.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>
