@model IEnumerable<practica2.Models.Inmueble>

<h2>Gestión de Inmuebles</h2>
<a asp-action="Create" class="btn btn-primary">Nuevo Inmueble</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Título</th>
            <th>Ciudad</th>
            <th>Activo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var i in Model)
        {
            <tr>
                <td>@i.Titulo</td>
                <td>@i.Ciudad</td>
                <td>@i.Activo</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@i.Id" class="btn btn-warning">Editar</a>
                    <form asp-action="ToggleActivo" method="post" style="display:inline">
                        <input type="hidden" name="id" value="@i.Id" />
                        <button type="submit" class="btn btn-secondary">
                            @(i.Activo ? "Desactivar" : "Activar")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
